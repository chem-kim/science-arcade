{
  "rules": {
    ".read": false,
    ".write": false,
    "superposition-bingo": {
      "rooms": {
        ".read": true,
        ".indexOn": ["meta/createdAt"],
        "$code": {
          ".write": true,
          ".validate": "$code.matches(/^[0-9]{4}$/)",
          "meta": {
            ".validate": "newData.hasChildren(['createdAt'])"
          },
          "players": {
            "$pid": {
              ".validate": "$pid.matches(/^[a-z0-9]{4,12}$/)",
              "name": { ".validate": "newData.isString() && newData.val().length <= 10" }
            }
          },
          "inbox": {
            "$id": {
              ".validate": "newData.hasChildren(['type', 'pid'])"
            }
          }
        }
      }
    },
    "element-rain": {
      "rooms": {
        ".read": true,
        ".indexOn": ["meta/createdAt"],
        "$code": {
          ".write": true,
          ".validate": "$code.matches(/^[0-9]{4}$/)",
          "meta": {
            ".validate": "newData.hasChildren(['createdAt'])"
          },
          "players": {
            "$pid": {
              ".validate": "$pid.matches(/^[a-z0-9]{4,12}$/)",
              "name": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "score": { ".validate": "newData.isNumber()" }
            }
          }
        }
      }
    },
    "mock-quiz": {
      "rooms": {
        ".read": true,
        ".indexOn": ["meta/createdAt"],
        "$code": {
          ".write": true,
          ".validate": "$code.matches(/^[0-9]{4}$/)",
          "meta": {
            ".validate": "newData.hasChildren(['createdAt'])"
          },
          "state": {
            ".validate": "newData.hasChildren(['qid', 'open'])"
          },
          "players": {
            "$pid": {
              ".validate": "$pid.matches(/^[a-z0-9]{4,12}$/)"
            }
          },
          "answers": {
            "$qid": {
              ".validate": "$qid.matches(/^[0-9]{1,2}-[0-9]{2}$/)",
              "$pid": {
                ".validate": "$pid.matches(/^[a-z0-9]{4,12}$/) && newData.hasChildren(['a']) && newData.child('a').isString() && newData.child('a').val().matches(/^([OX]{2,3}|[1-5])$/)"
              }
            }
          }
        }
      }
    }
  }
}
